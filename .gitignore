/outputs/
/output/

# Research scratch space and unrelated document-generation work
/.tmp/
/tmp/
/work/
/scripts/
/papers/**/*.pdf

# Python caches and tooling
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*~
