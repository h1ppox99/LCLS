# --- LCLS data mirror (large, not source) ---
/calib
/xtc

# caches
.vscode/
.ruff_cache/
.pytest_cache/

# --- automask reference masks & generated outputs ---
# automask/data/ now holds only the hand-drawn reference masks (data/masks/);
# every array a pipeline consumes is computed from XTC via ImageStore.
automask/cache
/automask/automask/cache/
/outputs/

# --- bulk archives ---
*.tar
*.tar.gz
*.cxi

# --- harness / editor ---
# Ignore local Claude state while keeping versioned project skills.
/.claude/*
!/.claude/skills/
.DS_Store

# --- binary / data blobs anywhere ---
*.xtc
*.h5
*.hdf5
*.npy
*.npz
!automask/data/masks/*.npy

# --- python ---
__pycache__/
*.pyc
*.egg-info/
.ipynb_checkpoints/
build/
dist/
.venv/

# machine-specific psana paths (see psana_env.sh header)
psana_env.local

# --- other ---
tmp/
